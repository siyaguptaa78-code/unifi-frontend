# ---------------------------------------------------------------
# UniCafe environment variables (copy to .env.local and adjust)
# ---------------------------------------------------------------

# MongoDB connection string. A replica set is required for multi-document
# transactions (Atlas clusters and `npm run db:local` both provide one).
MONGODB_URI=mongodb://127.0.0.1:27017/unicafe?replicaSet=rs0

# Secret used to sign session JWTs. Use a long random value (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime in hours
SESSION_TTL_HOURS=12

# Public base URL (used for password reset links)
APP_URL=http://localhost:3000

# Payment mode: "demo" (simulated, no real money) or "razorpay" (test/live keys)
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notification delivery providers: "mock" logs to console/DB only.
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock

